# Public-safe staging environment example.
# Copy to /opt/myproject001-staging/.env.staging on the VPS.
# Do not commit the real .env.staging file.

STAGING_DOMAIN=staging.example.com
POSTGRES_DB=myproject001
POSTGRES_USER=myproject001
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
QDRANT_API_KEY=CHANGE_ME_LONG_RANDOM_VALUE
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
OPA_LOG_LEVEL=info
